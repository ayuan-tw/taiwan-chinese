{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chengci-owner-sync",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  // Runtime settings are dashboard-managed: SYNC_ENABLED (start with false),
  // APP_ORIGIN and GOOGLE_CLIENT_ID. Keep required OWNER_EMAIL and optional
  // OWNER_SUB in server-only secrets. Do not redeclare them in a vars block:
  // a later Git deploy must not overwrite the approved runtime settings.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chengci-personal",
      "database_id": "REPLACE_WITH_APPROVED_D1_ID",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": false }
}
